root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,csproj,props,slnx}]
indent_size = 2

[*.sh]
end_of_line = lf

[*.cs]
# Explicit types, never var.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning

# this. on instance members; no underscore prefix on private fields.
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning

# File-scoped namespace, and the using directives after it.
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = inside_namespace:warning

# Always braced.
csharp_prefer_braces = true:warning

# Primary constructors, collection expressions, null and pattern checks.
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# Unused usings are errors in the style check.
dotnet_diagnostic.IDE0005.severity = warning

# Not formatted or checked: generated code.
[**/Migrations/*.cs]
generated_code = true

