[Unit]
Description=chisBallot admin site
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=chisballot-admin
Group=chisballot-admin
WorkingDirectory=/opt/chisballot/admin/current
EnvironmentFile=/etc/chisballot/admin.env
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/usr/bin/dotnet /opt/chisballot/admin/current/ChisBallot.Admin.dll
Restart=on-failure
RestartSec=3

# Writes only its own account file and sign-in keys.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chisballot-admin
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
LockPersonality=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
