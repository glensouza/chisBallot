#!/bin/sh
# Puts a freshly built release into service. Run as root, and only through the
# one sudo rule the production runner has (see setup.sh):
#
#   sudo /usr/local/sbin/chisballot-deploy <folder containing vote/, admin/, migrator/> [ops folder]
#
# The optional second folder holds ops/lxc from the same commit. After a successful
# deploy the scripts in it (this one included) are installed, so the server's scripts
# change with the code and nobody installs them by hand. Each is syntax-checked first.
#
# The folder must be inside the production runner's work area. Order of events:
# copy the build to a new release folder, apply database changes, switch the
# "current" links, restart, check the sites answer, and go back to the previous
# release (and the database it found) if they do not. Old releases and snapshots are
# kept (three each).
#
# It refuses to start while a real vote is open (see chisballot-lib.sh). To deploy
# anyway, as root: CHISBALLOT_FORCE_DEPLOY=1 chisballot-deploy <folder>
set -eu

. /usr/local/lib/chisballot/chisballot-lib.sh

ALLOWED=/home/runner-prod/actions-runner/_work/
KEEP=3

STAGE=${1:?usage: chisballot-deploy <build folder>}
REAL=$(realpath -e -- "$STAGE")
case "$REAL/" in
    "$ALLOWED"*) ;;
    *) echo "refusing: $REAL is not inside the runner work area" >&2; exit 2 ;;
esac

for app in vote admin migrator; do
    if [ ! -d "$REAL/$app" ] || [ -L "$REAL/$app" ]; then
        echo "refusing: $REAL/$app is missing or is a link" >&2
        exit 2
    fi
done
[ -f "$REAL/vote/ChisBallot.Vote.Server.dll" ] && [ -f "$REAL/admin/ChisBallot.Admin.dll" ] && [ -f "$REAL/migrator/ChisBallot.Migrator.dll" ] || {
    echo "refusing: the build is missing a program" >&2
    exit 2
}

open=$(open_votes)
if [ "$open" != 0 ] && [ "${CHISBALLOT_FORCE_DEPLOY:-}" != 1 ]; then
    echo "refusing: $open real vote(s) are open. Deploy after they close." >&2
    exit 3
fi

STAMP=$(date -u +%Y%m%dT%H%M%SZ)
echo "Release $STAMP"

echo "Taking a snapshot of the database and admin accounts"
snapshot "$STAMP"
# The encrypted copy that leaves this machine. Its failure does not stop a deploy;
# the snapshot above is what a rollback uses.
/usr/local/sbin/chisballot-backup || echo "warning: the encrypted backup failed" >&2

for app in vote admin migrator; do
    DST=$BASE/$app/releases/$STAMP
    install -d -m 755 "$DST"
    # No links, devices or special files are copied, whatever the build folder holds.
    rsync -rt --no-links --no-devices --no-specials --chmod=D755,F644 "$REAL/$app/" "$DST/"
    chown -R root:root "$DST"
done

echo "Applying database changes"
# systemd reads the settings file itself (the connection strings contain semicolons,
# which a shell would split) and runs the migrator as its own user, sandboxed.
systemd-run --quiet --wait --pipe --collect     -p User=chisballot-migrate     -p EnvironmentFile=/etc/chisballot/owner.env     -p WorkingDirectory="$BASE/migrator/releases/$STAMP"     -p ProtectSystem=strict -p ProtectHome=true -p PrivateTmp=true -p NoNewPrivileges=true     /usr/bin/dotnet ChisBallot.Migrator.dll

switch vote "releases/$STAMP"
switch admin "releases/$STAMP"
systemctl restart chisballot-vote chisballot-admin

if ! wait_healthy; then
    echo "The sites did not come up healthy; rolling back" >&2
    /usr/local/sbin/chisballot-rollback --auto "$STAMP" || true
    exit 1
fi
echo "Both sites are answering."

for app in vote admin migrator; do
    # Keep the newest releases (and whatever "current" points at); remove the rest.
    ls -1dt "$BASE/$app"/releases/* 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r old; do
        [ "$(readlink -f "$BASE/$app/current" 2>/dev/null || true)" = "$old" ] || rm -rf -- "$old"
    done
done
echo "Deployed $STAMP"

# Bring the server's own scripts up to date with the commit that was just deployed.
# Done last, and this script goes in last, so a run is never changed under itself.
OPS_FOLDER=${2:-}
if [ -n "$OPS_FOLDER" ]; then
    OPS=$(realpath -e -- "$OPS_FOLDER" 2>/dev/null || true)
    case "$OPS/" in
        "$ALLOWED"*)
            ok=1
            for f in chisballot-lib.sh chisballot-rollback chisballot-backup chisballot-deploy; do
                if [ ! -f "$OPS/$f" ] || [ -L "$OPS/$f" ] || ! sh -n "$OPS/$f"; then
                    echo "not updating the server scripts: $f is missing or does not parse" >&2
                    ok=0
                fi
            done
            if [ "$ok" = 1 ]; then
                install -d -m 755 /usr/local/lib/chisballot
                install -m 644 "$OPS/chisballot-lib.sh" /usr/local/lib/chisballot/chisballot-lib.sh
                install -m 755 "$OPS/chisballot-rollback" /usr/local/sbin/chisballot-rollback
                install -m 755 "$OPS/chisballot-backup" /usr/local/sbin/chisballot-backup
                install -m 755 "$OPS/chisballot-deploy" /usr/local/sbin/chisballot-deploy
                echo "Updated the server scripts"
            fi
            ;;
        *) echo "not updating the server scripts: $OPS is not inside the runner work area" >&2 ;;
    esac
fi
