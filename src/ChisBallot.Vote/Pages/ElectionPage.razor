@page "/e/{Slug}"
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(this.election?.Name ?? "Vote")</PageTitle>

@if (this.election is null)
{
    <p>@(this.notFound ? "That vote could not be found." : "Loading…")</p>
}
else
{
    @if (this.election.IsDemo)
    {
        <div class="demo-banner">DEMO: not a real vote</div>
    }

    <h1>@this.election.Name</h1>
    <p>@StatusText(this.election.Status)</p>

    @if (this.election.RevoteOfSlug is not null)
    {
        <p>This is a revote for questions that ended in a tie in <a href="e/@this.election.RevoteOfSlug">the earlier vote</a>.</p>
    }

    @if (this.election.RevoteSlug is not null)
    {
        <p><strong>Some questions ended in a tie.</strong> The tied choices are decided in <a href="e/@this.election.RevoteSlug">a revote</a>.</p>
    }

    @if (this.election.IsDemo && this.election.Status == 1)
    {
        <p>At a real vote the slip comes from the pile on the table. Here, a button hands you one.</p>
        <button class="chis-button" disabled="@this.busy" @onclick="this.GetSlipAsync">Get a demo slip</button>
        @if (this.slipError)
        {
            <p class="error">No demo slip is available right now.</p>
        }
    }

    @if (this.results is not null)
    {
        <h2>@(this.election.Status == 2 ? "Results" : "Running totals")</h2>
        @if (this.election.Status == 1)
        {
            <p class="hint">Write-ins are shown as one combined count until the vote closes.</p>
        }

        <ResultsView Contests="this.results" />
    }

    @if (this.turnout is not null)
    {
        <div class="chis-card">
            <h2>Turnout</h2>
            <p><strong>@this.turnout.CodesUsed</strong> of <strong>@this.turnout.CodesIssued</strong> slips used</p>
            <div class="meter" role="progressbar" aria-valuenow="@this.turnout.CodesUsed" aria-valuemin="0" aria-valuemax="@this.turnout.CodesIssued">
                <div style="width: @this.Percent()%"></div>
            </div>
            <p>This shows how many have voted, never what they chose.</p>
        </div>
    }

    <p><a href="audit/@this.election.Slug">Audit page: check the numbers and find your receipt</a></p>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private readonly CancellationTokenSource stop = new();
    private ElectionView? election;
    private TurnoutView? turnout;
    private IReadOnlyList<ContestResult>? results;
    private bool notFound;
    private bool busy;
    private bool slipError;

    private async Task GetSlipAsync()
    {
        this.busy = true;
        this.slipError = false;
        try
        {
            HttpResponseMessage response = await this.Http.PostAsync($"api/elections/{Uri.EscapeDataString(this.Slug)}/demo-slip", null);
            DemoSlipResponse? slip = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<DemoSlipResponse>() : null;
            if (slip is null)
            {
                this.slipError = true;
                return;
            }

            this.Navigation.NavigateTo($"v/{Uri.EscapeDataString(this.Slug)}#{slip.Code}");
        }
        catch (HttpRequestException)
        {
            this.slipError = true;
        }
        finally
        {
            this.busy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            this.election = await this.Http.GetFromJsonAsync<ElectionView>($"api/elections/{Uri.EscapeDataString(this.Slug)}");
        }
        catch (HttpRequestException)
        {
            this.notFound = true;
            return;
        }

        _ = this.PollAsync();
    }

    // Near real time: ask for turnout every few seconds.
    private async Task PollAsync()
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(5));
        do
        {
            try
            {
                this.turnout = await this.Http.GetFromJsonAsync<TurnoutView>($"api/elections/{Uri.EscapeDataString(this.Slug)}/turnout", this.stop.Token);
                await this.LoadResultsAsync();
                await this.InvokeAsync(this.StateHasChanged);
            }
            catch (HttpRequestException)
            {
                // Try again on the next tick.
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }
        while (await this.WaitAsync(timer));
    }

    // Results exist only for a Closed election, or an Open one with live results on;
    // otherwise the server answers 404 and nothing is shown. A closed one is read once.
    private async Task LoadResultsAsync()
    {
        if (this.election is null || this.election.Status == 0 || (this.election.Status == 1 && !this.election.ShowLiveResults) || (this.election.Status == 2 && this.results is not null))
        {
            return;
        }

        HttpResponseMessage response = await this.Http.GetAsync($"api/elections/{Uri.EscapeDataString(this.Slug)}/results", this.stop.Token);
        if (response.IsSuccessStatusCode)
        {
            this.results = await response.Content.ReadFromJsonAsync<List<ContestResult>>(this.stop.Token);
        }
    }

    private async Task<bool> WaitAsync(PeriodicTimer timer)
    {
        try
        {
            return await timer.WaitForNextTickAsync(this.stop.Token);
        }
        catch (OperationCanceledException)
        {
            return false;
        }
    }

    private static string StatusText(int status) => status switch
    {
        0 => "This vote has not opened yet.",
        1 => "This vote is open.",
        _ => "This vote is closed.",
    };

    private int Percent() => this.turnout is null || this.turnout.CodesIssued == 0 ? 0 : this.turnout.CodesUsed * 100 / this.turnout.CodesIssued;

    public void Dispose()
    {
        this.stop.Cancel();
        this.stop.Dispose();
    }
}
