{
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/_framework/*", "/css/*", "/*.ico", "/*.png"]
  },
  "globalHeaders": {
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff"
  }
}
