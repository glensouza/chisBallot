@inherits LayoutComponentBase

<header class="chis-header">
    <a class="chis-brand" href="/">
        <img class="chis-logo" src="@Assets["logo.png"]" alt="Citrus Hills Intermediate School jaguar" width="360" height="214" />
        <strong>chisBallot admin</strong>
    </a>
    <AuthorizeView>
        <Authorized>
            &nbsp;|&nbsp;
            <a href="/" style="color: #fff">Votes</a>
            &nbsp;|&nbsp;
            <a href="Account/Manage" style="color: #fff">@context.User.Identity?.Name</a>
            &nbsp;|&nbsp;
            <form action="Account/Logout" method="post" style="display: inline">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="link-button" style="color: #fff">Sign out</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>

<main>
    @Body
</main>
