<Router AppAssembly="typeof(Routes).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <h1>One more step</h1>
                    <p>
                        You are signed in, but the admin pages open only for an admin who has a second factor.
                        Add a <a href="Account/Manage/Passkeys">passkey</a> or an
                        <a href="Account/Manage/TwoFactorAuthentication">authenticator app</a>, then come back.
                        If you were just invited and still cannot get in, ask an admin to check you are in the admin role.
                    </p>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
