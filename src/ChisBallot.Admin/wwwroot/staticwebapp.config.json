{
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  },
  "routes": [
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/login", "redirect": "/.auth/login/github" },
    { "route": "/logout", "redirect": "/.auth/logout" },
    { "route": "/api/*", "allowedRoles": ["admin"] },
    { "route": "/*", "allowedRoles": ["admin"] }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/_framework/*", "/css/*", "/*.ico", "/*.png"]
  },
  "globalHeaders": {
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff"
  }
}
