@page "/elections/{Id:guid}"
@attribute [Authorize(Policy = AdminAuth.PolicyName)]
@inject AdminViews Views
@inject ElectionAdmin AdminService
@inject IConfiguration Configuration
@inject IJSRuntime Js
@inject NavigationManager Navigation

<PageTitle>@(this.view?.Election.Name ?? "Vote")</PageTitle>

<p class="no-print"><a href="/">&larr; All votes</a></p>

@if (this.error is not null && this.view is null)
{
    <p class="error">@this.error</p>
}
else if (this.view is null)
{
    <p>Loading…</p>
}
else
{
    ElectionView election = this.view.Election;

    @if (this.slips is not null)
    {
        <div class="no-print">
            <h1>Slips for @election.Name</h1>
            <p class="warn">
                <strong>These are shown once.</strong> Only a scrambled form of each code is stored, so if you leave this page
                the codes cannot be shown again. Print them now.
            </p>
            <button class="chis-button" @onclick="this.PrintAsync">Print the slips</button>
            <button class="link-button" @onclick="() => this.slips = null">I have printed them, hide</button>
        </div>
        <SlipSheet Codes="this.slips" Slug="@election.Slug" Name="@election.Name" VoteSiteUrl="@this.VoteSiteUrl" />
    }

    <div class="no-print">
    <h1>@election.Name</h1>
    <p>
        <span class="badge">@StatusText(election.Status)</span>
        Voters see it at <strong>/e/@election.Slug</strong> on the voting site.
        <a href="/elections/@election.Id/paper">Paper ballots and count sheet</a>
    </p>

    <div class="chis-card">
        <h2>Setup</h2>
        <ul>
            <li>Random question order: @YesNo(election.ShuffleContests)</li>
            <li>Random option order: @YesNo(election.ShuffleChoices)</li>
            <li>Running totals while open: @YesNo(election.ShowLiveResults)</li>
        </ul>
        @foreach (ContestView contest in election.Contests)
        {
            <p>
                <strong>@contest.Title</strong>:
                @contest.Seats @(contest.Seats == 1 ? "seat" : "seats"), up to @contest.MaxSelections
                @(contest.AllowWriteIn ? ", write-ins allowed" : string.Empty)<br />
                @string.Join(", ", contest.Choices.Select(c => c.Label))
            </p>
        }
    </div>

    <div class="chis-card">
        <h2>Turnout</h2>
        <p>@this.view.Turnout.CodesUsed of @this.view.Turnout.CodesIssued slips used.</p>
    </div>

    @if (this.error is not null)
    {
        <p class="error">@this.error</p>
    }

    @if (election.Status == 0)
    {
        <div class="chis-card">
            <h2>Open the vote</h2>
            @if (this.view.Turnout.CodesIssued == 0)
            {
                <p>A vote can open only after its slips exist. Slips can be made once, so count your voters first.</p>
                <label>How many slips? <input type="number" min="1" max="@SlipLimits.Max" @bind="this.slipCount" class="count-input" /></label>
                <button class="chis-button" disabled="@this.busy" @onclick="this.MakeSlipsAsync">Make slips</button>
            }
            else
            {
                <p>Once open, the questions, options and settings cannot change.</p>
                <button class="chis-button" disabled="@this.busy" @onclick="this.OpenAsync">Open the vote</button>
            }
        </div>
    }
    else if (election.Status == 1)
    {
        <div class="chis-card">
            <h2>Close the vote</h2>
            @if (!this.confirmClose)
            {
                <button class="chis-button" @onclick="() => this.confirmClose = true">Close the vote…</button>
            }
            else
            {
                <p><strong>Closing cannot be undone.</strong> Unused slips stop working and are deleted, and the results are published.</p>
                <button class="chis-button" disabled="@this.busy" @onclick="this.CloseAsync">Yes, close it now</button>
                <button class="link-button" @onclick="() => this.confirmClose = false">Cancel</button>
            }
        </div>
    }

    @if (election.RevoteOfSlug is not null)
    {
        <p class="hint">This is a revote. It follows <strong>/e/@election.RevoteOfSlug</strong>.</p>
    }

    @if (election.Status == 2 && this.view.Results is not null && this.view.Results.Any(result => result.Tie is not null))
    {
        <div class="chis-card">
            <h2>Revote</h2>
            @if (election.RevoteId is Guid revoteId)
            {
                <p>A revote was made: <a href="/elections/@revoteId">/e/@election.RevoteSlug</a>.</p>
            }
            else
            {
                <p>
                    Some questions ended in a tie. A revote is a new vote with only those questions, only the tied choices
                    and the seats still open. It starts as a draft and needs its own slips.
                </p>
                <button class="chis-button" disabled="@this.busy" @onclick="this.StartRevoteAsync">Make the revote</button>
            }
        </div>
    }

    @if (this.view.Results is not null)
    {
        <h2>@(election.Status == 2 ? "Results" : "Running totals")</h2>
        @if (election.Status == 1)
        {
            <p class="warn">Running totals only. Write-ins are combined until the vote closes, and ties are not judged yet.</p>
        }

        @foreach (ContestResult contest in this.view.Results)
        {
            <h3>@contest.Title</h3>
            @if (election.Status == 2 && contest.Tie is not null)
            {
                <p class="error">
                    Tie: revote needed. @string.Join(" and ", contest.Tie.TiedLabels) are level for
                    @contest.Tie.OpenSeats open @(contest.Tie.OpenSeats == 1 ? "seat" : "seats").
                    The site does not break ties. Run a new vote with only these choices.
                </p>
            }

            <table>
                <thead><tr><th>Choice</th><th>Votes</th><th></th></tr></thead>
                <tbody>
                    @foreach (ResultEntry entry in contest.Entries)
                    {
                        <tr>
                            <td>@entry.Label @(entry.IsWriteIn ? "(write-in)" : string.Empty)</td>
                            <td>@entry.Votes</td>
                            <td>@(election.Status == 2 && entry.IsWinner ? "Winner" : string.Empty)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ElectionAdminView? view;
    private string? error;
    private bool busy;
    private bool confirmClose;
    private int slipCount = 40;
    private IReadOnlyList<string>? slips;

    private string VoteSiteUrl => this.Configuration["VoteSiteUrl"] ?? "https://vote.chisballot.org";

    private async Task StartRevoteAsync()
    {
        this.busy = true;
        this.error = null;
        try
        {
            CreateElectionResponse response = await this.Views.StartRevoteAsync(this.Id);
            if (response.Id is Guid newId)
            {
                this.Navigation.NavigateTo($"/elections/{newId}");
                return;
            }

            this.error = response.Error;
        }
        finally
        {
            this.busy = false;
        }
    }

    private async Task PrintAsync()
    {
        try
        {
            await this.Js.InvokeVoidAsync("print");
        }
        catch (JSException)
        {
            this.error = "The browser would not open the print dialog. Use the browser's own print command.";
        }
    }

    private async Task MakeSlipsAsync()
    {
        this.busy = true;
        this.error = null;
        try
        {
            IReadOnlyList<string>? codes = await this.AdminService.IssueSlipsAsync(this.Id, this.slipCount);
            if (codes is not null)
            {
                this.slips = codes;
            }
            else
            {
                this.error = $"Slips can be made once, for a draft that has none, between 1 and {SlipLimits.Max}.";
            }

            await this.LoadAsync();
        }
        catch (Npgsql.NpgsqlException)
        {
            this.error = "The database could not be reached.";
        }
        finally
        {
            this.busy = false;
        }
    }

    protected override async Task OnInitializedAsync() => await this.LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            this.view = await this.Views.LoadAsync(this.Id);
            if (this.view is null)
            {
                this.error = "That vote could not be found.";
            }
        }
        catch (Npgsql.NpgsqlException)
        {
            this.error = "The database could not be reached.";
        }
    }

    private async Task OpenAsync()
    {
        this.busy = true;
        this.error = null;
        try
        {
            if (!await this.AdminService.OpenAsync(this.Id))
            {
                this.error = "Only a draft that has slips can be opened.";
            }

            await this.LoadAsync();
        }
        finally
        {
            this.busy = false;
        }
    }

    private async Task CloseAsync()
    {
        this.busy = true;
        this.error = null;
        try
        {
            if (!await this.AdminService.CloseAsync(this.Id))
            {
                this.error = "Only an open vote can be closed.";
            }

            this.confirmClose = false;
            await this.LoadAsync();
        }
        finally
        {
            this.busy = false;
        }
    }

    private static string YesNo(bool value) => value ? "yes" : "no";

    private static string StatusText(int status) => status switch
    {
        0 => "Draft",
        1 => "Open",
        _ => "Closed",
    };
}
