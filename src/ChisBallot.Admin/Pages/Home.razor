@page "/"
@using Npgsql
@attribute [Authorize(Policy = AdminAuth.PolicyName)]
@inject ElectionReader Elections
@inject ElectionAdmin AdminService

<PageTitle>chisBallot admin</PageTitle>

<h1>Votes</h1>

<p><a class="chis-button" href="/new">New vote</a> <a href="/invite">Invite an admin</a></p>

@if (this.error is not null)
{
    <p class="error">@this.error</p>
}
else if (this.elections is null)
{
    <p>Loading…</p>
}
else
{
    <p>Signed in as <strong>@this.me</strong>.</p>

    @if (this.elections.Count == 0)
    {
        <div class="chis-card"><p>There are no votes yet. Make one with "New vote".</p></div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Name</th><th>Address</th><th>Status</th><th>Slips</th></tr>
            </thead>
            <tbody>
                @foreach (ElectionSummary election in this.elections)
                {
                    <tr>
                        <td><a href="/elections/@election.Id">@election.Name</a> @(election.IsDemo ? "(demo)" : string.Empty)</td>
                        <td>/e/@election.Slug</td>
                        <td><span class="badge">@StatusText(election.Status)</span></td>
                        <td>@election.CodesIssued</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (this.elections is not null)
{
    <div class="chis-card">
        <h2>Demo votes</h2>
        <p>
            The demo vote and the tie demo are for showing the site. Resetting deletes their ballots, and any revote made from
            them, and makes both fresh: the demo opens empty, the tie demo is closed with its made-up tie. Real votes are not touched.
        </p>
        @if (!this.confirmReset)
        {
            <button class="chis-button" @onclick="() => this.confirmReset = true">Reset the demos…</button>
        }
        else
        {
            <button class="chis-button" disabled="@this.busy" @onclick="this.ResetDemosAsync">Yes, reset the demos now</button>
            <button class="link-button" @onclick="() => this.confirmReset = false">Cancel</button>
        }

        @if (this.resetMessage is not null)
        {
            <p>@this.resetMessage</p>
        }
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string? me;
    private IReadOnlyList<ElectionSummary>? elections;
    private string? error;
    private bool confirmReset;
    private bool busy;
    private string? resetMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState state = await this.AuthenticationState!;
            this.me = state.User.Identity?.Name;
            this.elections = await this.Elections.ListAsync();
        }
        catch (Npgsql.NpgsqlException)
        {
            this.error = "The database could not be reached.";
        }
    }

    private async Task ResetDemosAsync()
    {
        this.busy = true;
        this.resetMessage = null;
        try
        {
            await this.AdminService.ResetDemosAsync();
            this.elections = await this.Elections.ListAsync();
            this.resetMessage = "The demos were reset.";
        }
        catch (NpgsqlException)
        {
            this.resetMessage = "The demos could not be reset. The database could not be reached.";
        }
        finally
        {
            this.busy = false;
            this.confirmReset = false;
        }
    }

    private static string StatusText(int status) => status switch
    {
        0 => "Draft",
        1 => "Open",
        _ => "Closed",
    };
}
