@page "/"
@attribute [Authorize(Policy = AdminAuth.PolicyName)]
@inject ElectionReader Elections

<PageTitle>chisBallot admin</PageTitle>

<h1>Votes</h1>

<p><a class="chis-button" href="/new">New vote</a> <a href="/invite">Invite an admin</a></p>

@if (this.error is not null)
{
    <p class="error">@this.error</p>
}
else if (this.elections is null)
{
    <p>Loading…</p>
}
else
{
    <p>Signed in as <strong>@this.me</strong>.</p>

    @if (this.elections.Count == 0)
    {
        <div class="chis-card"><p>There are no votes yet. Make one with "New vote".</p></div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Name</th><th>Address</th><th>Status</th><th>Slips</th></tr>
            </thead>
            <tbody>
                @foreach (ElectionSummary election in this.elections)
                {
                    <tr>
                        <td><a href="/elections/@election.Id">@election.Name</a> @(election.IsDemo ? "(demo)" : string.Empty)</td>
                        <td>/e/@election.Slug</td>
                        <td><span class="badge">@StatusText(election.Status)</span></td>
                        <td>@election.CodesIssued</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string? me;
    private IReadOnlyList<ElectionSummary>? elections;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState state = await this.AuthenticationState!;
            this.me = state.User.Identity?.Name;
            this.elections = await this.Elections.ListAsync();
        }
        catch (Npgsql.NpgsqlException)
        {
            this.error = "The database could not be reached.";
        }
    }

    private static string StatusText(int status) => status switch
    {
        0 => "Draft",
        1 => "Open",
        _ => "Closed",
    };
}
