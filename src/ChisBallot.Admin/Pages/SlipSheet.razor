@using QRCoder

<div class="slips">
    @foreach (string slipCode in this.Codes)
    {
        string link = $"{this.VoteSiteUrl.TrimEnd('/')}/v/{this.Slug}#{slipCode}";
        <div class="slip">
            <div class="slip-qr">@((MarkupString)QrSvg(link))</div>
            <div class="slip-text">
                <strong>@this.Name</strong>
                <span>Scan with a phone camera to vote. Or type this address into a browser:</span>
                <code>@(this.VoteHost)/v/@(this.Slug)<wbr />#@(slipCode)</code>
                <span class="slip-note">One use only. Keep it private.</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Codes { get; set; } = [];

    [Parameter, EditorRequired]
    public string Slug { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string VoteSiteUrl { get; set; } = string.Empty;

    private string VoteHost => this.VoteSiteUrl.Replace("https://", string.Empty).Replace("http://", string.Empty).TrimEnd('/');

    private static string QrSvg(string link)
    {
        using QRCodeGenerator generator = new();
        using QRCodeData data = generator.CreateQrCode(link, QRCodeGenerator.ECCLevel.M);
        return new SvgQRCode(data).GetGraphic(4);
    }
}
